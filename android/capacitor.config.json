{
  "appId": "com.nenchan.app",
  "appName": "Nenchan",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "url": "https://nenchan.vercel.app/api",
    "cleartext": false,
    "allowNavigation": ["*"]
  },
  "android": {
    "backgroundColor": "#00000000",
    "allowMixedContent": true,
    "captureInput": true
  },
  "plugins": {
    "StatusBar": {
      "style": "LIGHT",
      "overlaysWebView": true
    }
  }
}
