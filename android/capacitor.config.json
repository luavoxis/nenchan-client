{
  "appId": "com.nenchan.app",
  "appName": "Nenchan",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "url": "https://nenchan.vercel.app/api",
    "cleartext": false,
    "allowNavigation": ["*"]
  },
  "android": {
    "backgroundColor": "#0d1117",
    "navigationBarColor": "#0d1117",
    "navigationBarContentColor": "#c9d1d9",
    "allowMixedContent": true,
    "captureInput": true
  },
  "plugins": {
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0d1117",
      "overlaysWebView": false
    }
  }
}
